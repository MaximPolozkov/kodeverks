# --- База данных (используется docker-compose) ---
POSTGRES_DB=itstudio
POSTGRES_USER=itstudio
POSTGRES_PASSWORD=change-me

# --- Приложение ---
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Публичный адрес сайта — бот вставляет его в ссылку на форму заказа
SITE_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# true, когда сайт работает по HTTPS
COOKIE_SECURE=false
HTTP_PORT=8080
# Заявок с одного IP в час
ORDER_RATE_LIMIT=5

# --- Первый администратор (создаётся при старте, если его ещё нет) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-please
FIRST_ADMIN_NAME=Администратор

# --- Бот: ВКонтакте ---
# Токен пользователя с доступом к newsfeed.search (поиск постов)
VK_USER_TOKEN=
# Токен сообщества с правом «Сообщения» и ID сообщества
VK_GROUP_TOKEN=
VK_GROUP_ID=242635535
# Уведомления о новых заказах в сообщения VK (vk.ru/im): ID менеджеров через запятую
# или peer_id беседы с ботом (2000000000 + номер беседы). Нужен VK_GROUP_TOKEN.
VK_NOTIFY_PEER_IDS=
# Callback API: строка подтверждения и секретный ключ из настроек сообщества
VK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=

# --- Бот: Telegram ---
TELEGRAM_BOT_TOKEN=
# Любая случайная строка; укажите её при setWebhook (secret_token)
TELEGRAM_WEBHOOK_SECRET=

# --- Бот: поиск по сайтам через SerpAPI ---
SERPAPI_KEY=

# --- Бот: языковая модель для ответов (anthropic | openai | none) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Для OpenAI-совместимых провайдеров, например https://api.example.com/v1
LLM_BASE_URL=
